{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start All Services (Batch)",
      "type": "shell",
      "command": ".\\run.bat",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "1. Run Payment Gateway (Port 3000)",
      "type": "shell",
      "command": "node payment-gateway/server.js",
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "2. Run Backend JWT Server (Port 5000)",
      "type": "shell",
      "command": "cd backend && node server.js",
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "3. Run Frontend Webpage (Port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
